{
  "name": "inp-protocol",
  "version": "2.0.0",
  "description": "Intent Network Protocol - Production-ready distributed system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "check:standards": "node scripts/enforce-standards.js",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "mock-service": "ts-node src/services/mock-payment-service.ts",
    "mock-inventory": "ts-node src/services/mock-inventory-service.ts",
    "mock-notification": "ts-node src/services/mock-notification-service.ts",
    "demo": "ts-node examples/ecommerce-ecosystem/run-demo.ts",
    "demo:services": "ts-node examples/ecommerce-ecosystem/start-ecosystem.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "axios": "^1.6.0",
    "axios-retry": "^4.0.0",
    "circuit-breaker-js": "^0.0.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.11.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
